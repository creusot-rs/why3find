(cram
  (deps why3.conf %{bin:why3find} (package why3find)))

(cram
 (applies_to prover_runs_json)
 (enabled_if %{bin-available:jq}))

(rule
 (action
  (write-file why3.conf
"\| [main]
"\| default_editor = "xdg-open %f"
"\| magic = 14
"\| memlimit = 1000
"\| timelimit = 5.000000
"\|
"\| [partial_prover]
"\| name = "Alt-Ergo"
"\| path = "%{bin:alt-ergo}"
"\| version = "2.4.2"
)))

(env
 (_
  (env-vars
   (WHY3CONFIG ../why3.conf)
   (WHY3FIND_JOBS 2)
   (WHY3FIND_DOWNLOADED no)
   (WHY3FIND_AUTODETECT no)
   (WHY3FIND_AUTOLOAD no)
   )))
